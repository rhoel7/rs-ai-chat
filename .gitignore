# Never commit real secrets — config.php holds live API keys, DB
# credentials, and the encryption key. Copy api/config.example.php to
# api/config.php and fill in real values there; config.php itself stays
# untracked.
api/config.php
api/config.bak.php

# Real business-specific RAG knowledge stays local, not published —
# pricing, policies, and other specifics don't belong permanently in a
# public repo's git history. Only the generic example template is meant
# to be shared. This covers any CSV dropped here, not just today's,
# so the same mistake can't happen again with a differently-named file.
api/rag/incoming/*.csv
!api/rag/incoming/example.csv

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.log

# Claude Code project context — kept local, not published. Claude Code
# still reads this from the project root regardless of git tracking
# status, it just never leaves this machine.
CLAUDE.md

# If a local PHP dependency setup is ever added (composer install)
/vendor/
